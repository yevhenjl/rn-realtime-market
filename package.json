{
  "name": "rn-realtime-market",
  "version": "0.1.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "expo-dev-client": "~58.0.14",
    "react-native-skia": "2.15.1",
    "uniwind": "1.13.0",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15",
    "@tanstack/react-query": "5.104.5",
    "zod": "4.6.7",
    "@shopify/flash-list": "2.3.2",
    "@react-native-community/netinfo": "12.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "@types/jest": "^30.0.0",
    "@testing-library/react-native": "14.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.21.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "uniwind:types": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "npm run -s uniwind:types && tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm test -- --ci --runInBand"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/app/_layout.tsx",
      "!src/ui/styled.ts"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "watchman": false
  }
}
